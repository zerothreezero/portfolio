{
  "name": "portfolio-admin",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://zerothreezero.github.io",
    "GOOGLE_CLIENT_ID": ""
  },
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "SessionRegistry" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionRegistry"] }],
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "301", "simple": { "limit": 30, "period": 60 } }]
}
